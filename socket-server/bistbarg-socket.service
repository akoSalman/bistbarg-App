# systemd service for the Bistbarg socket server.
# install.sh writes this automatically. For a manual setup:
#   echo "BISTBARG_SECRET=<secret from WordPress>" > /etc/bistbarg-socket.env && chmod 600 /etc/bistbarg-socket.env
#   useradd --system --no-create-home --shell /usr/sbin/nologin bistbarg
#   cp bistbarg-socket.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now bistbarg-socket
[Unit]
Description=Bistbarg app notification socket server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bistbarg-socket
ExecStart=/usr/local/bin/node /opt/bistbarg-socket/server.js
EnvironmentFile=/etc/bistbarg-socket.env
Restart=always
RestartSec=3
User=bistbarg
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
