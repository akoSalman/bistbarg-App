# systemd service for the Bistbarg socket server.
# Install:
#   sudo cp bistbarg-socket.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/bistbarg-socket.service   # set BISTBARG_SECRET and paths
#   sudo systemctl daemon-reload && sudo systemctl enable --now bistbarg-socket
[Unit]
Description=Bistbarg app notification socket server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bistbarg-socket
ExecStart=/usr/bin/node /opt/bistbarg-socket/server.js
Environment=BISTBARG_SECRET=PASTE_THE_SECRET_FROM_WORDPRESS_HERE
Environment=PORT=8090
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
