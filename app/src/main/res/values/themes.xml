<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bistbarg" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Bistbarg.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Bistbarg</item>
    </style>

    <!-- Native screens (welcome, sign-up) -->
    <style name="Theme.Bistbarg.Native" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/gold_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">#F6EFD2</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/gold_dark</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
</resources>
